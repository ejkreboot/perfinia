# Supabase — project "Dev" (jxewfukwdmakubggytsw), shared across several small apps.
# Safe to expose in the browser bundle:
PUBLIC_SUPABASE_URL=https://jxewfukwdmakubggytsw.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Get from Supabase dashboard:
# Project Settings > API > service_role secret key. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Plaid — https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Public HTTPS URL Plaid will POST webhooks to (Vercel Preview/Production domain).
# Leave unset for pure local dev — webhooks can't reach localhost.
PLAID_WEBHOOK_URL=

# Server-only — 32-byte key (base64) used to encrypt Plaid access_tokens at rest.
# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
